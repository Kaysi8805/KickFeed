# API-Football — never commit a real secret.
# Signup: https://dashboard.api-football.com/register
# Then Account → My Access, copy the key.

# Preferred for multi-device demos: point the app at the in-repo BFF (see bff/README.md).
# Live coverage when the BFF/key is set: England PL + Championship, Slovakia Niké Liga (332), La Liga (140).
# Leave the public API key empty when this is set so the key stays server-side.
# EXPO_PUBLIC_FOOTBALL_BFF_URL=http://127.0.0.1:8787
#
# BFF process only (never EXPO_PUBLIC_, never commit, never CI):
# FOOTBALL_API_KEY=your_api_football_key

# Direct client key (solo local only). Exposed in the JS bundle — prefer the BFF above.
EXPO_PUBLIC_FOOTBALL_API_KEY=

# Optional: season start year (defaults to the current European season, e.g. Sep 2026 → 2026)
# EXPO_PUBLIC_FOOTBALL_SEASON=2026

# Supabase Auth — never commit a real project’s keys (anon is public-by-design with RLS,
# but .env stays gitignored). Signup: https://supabase.com (free project).
# Settings → API → Project URL + anon public key.
# Authentication → Providers → enable Email. Optional later: Google / Apple.
# For local demos, Authentication → Providers → Email → Confirm email can be off.
# Leave both empty to keep the demo profile picker only (CI / Expo Go without a project).
# Same keys enable live prediction leaderboards and report/block sync (Postgres). Empty = local demo ranking + local safety lists.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Expo EAS projectId for remote push tokens (not a secret, but keep .env gitignored).
# Prefer `eas init` which writes extra.eas.projectId into app.json (commit that UUID).
# Expo → Project settings → General → Project ID, or skip eas init and paste here.
# Empty = no Expo push token; local kickoff/goal alerts still work after Profile opt-in.
# Never commit Expo access tokens, FCM keys, or google-services.json.
# EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_PROJECT_ID=
